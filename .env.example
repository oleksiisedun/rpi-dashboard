DISPLAY_SPI_BUS=0
DISPLAY_SPI_DEVICE=0
DISPLAY_DEFAULT_SPEED_MS=40
DISPLAY_DEFAULT_BRIGHTNESS=5
DISPLAY_DEFAULT_ROTATE=false
DISPLAY_DEFAULT_DIRECTION=rtl
DISPLAY_OVERLAY_DURATION_MS=60000

# Ambient mode — digital rain animation
AMBIENT_TICK_MS=80
AMBIENT_DEFAULT_BRIGHTNESS=8
AMBIENT_DEFAULT_DIRECTION=down
AMBIENT_DEFAULT_SPEED=10
AMBIENT_DEFAULT_DROP_SIZE=3

TM1638_STB_PIN=29
TM1638_CLK_PIN=31
TM1638_DIO_PIN=33
TM1638_BRIGHTNESS=3
TOTP_SHOW_DURATION_MS=15000
ERROR_SHOW_DURATION_MS=3000
POLL_INTERVAL_MS=60

# Standalone GPIO push-button (normally-closed) that mimics the TM1638's S1
TOTP_BUTTON_PIN=15

# Periodic connectivity check — shows an error on the MAX7219 when offline
NETWORK_CHECK_INTERVAL_MS=30000
NETWORK_PROBE_HOST=1.1.1.1
NETWORK_PROBE_PORT=443
NETWORK_PROBE_TIMEOUT_MS=5000
NETWORK_ERROR_MESSAGE=NO NETWORK CONNECTION
